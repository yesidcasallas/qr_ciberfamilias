---
import { logos } from '../data/logos.js';

/** Símbolo de CiberFamilias, sin el nombre, para acompañar títulos y formularios. */
const { class: className } = Astro.props;
---

<img
  class:list={['seal', className]}
  src={logos.icon}
  width="1280"
  height="1280"
  alt=""
  aria-hidden="true"
  decoding="async"
/>
